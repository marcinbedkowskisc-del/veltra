APP_NAME="VELTRA 2.0"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
DEV_MANAGEMENT_ENABLED=false
DEV_MANAGEMENT_TOKEN=
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
APP_LOCALE=pl
APP_FALLBACK_LOCALE=pl
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=veltra
DB_USERNAME=veltra_app
DB_PASSWORD=

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000,127.0.0.1:5173,127.0.0.1:8000
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=file
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=noreply@veltra.test
MAIL_FROM_NAME="VELTRA 2.0"
